{
  "//": "archinstall config. Schema is version-specific — regenerate with `archinstall --dry-run` and 'Save configuration' if your ISO's archinstall differs. device is filled in at boot by automated_install.sh.",
  "archinstall-language": "English",
  "bootloader": "Grub",
  "hostname": "arch-auto",
  "kernels": ["linux"],
  "locale_config": {
    "kb_layout": "us",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US"
  },
  "network_config": {
    "type": "nm"
  },
  "ntp": true,
  "packages": ["openssh", "sudo", "vim"],
  "profile_config": {
    "profile": {
      "main": "Minimal"
    }
  },
  "services": ["sshd"],
  "timezone": "UTC",
  "disk_config": {
    "config_type": "default_layout",
    "device_modifications": [
      {
        "device": "/dev/PLACEHOLDER_FILLED_AT_BOOT",
        "wipe": true,
        "partitions": []
      }
    ]
  }
}
